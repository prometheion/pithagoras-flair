{
  "name": "@pithagoras/flair-avatar",
  "version": "0.1.0",
  "description": "A 3D avatar for Pithagoras voice mode: a VRM model drawn where the orb is, which lip-syncs, blinks, breathes and looks at you",
  "type": "module",
  "keywords": [
    "pi-package",
    "pithagoras",
    "vrm",
    "avatar",
    "voice"
  ],
  "homepage": "https://github.com/thecodacus/pithagoras-flair/tree/main/avatar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thecodacus/pithagoras-flair.git",
    "directory": "avatar"
  },
  "bugs": {
    "url": "https://github.com/thecodacus/pithagoras-flair/issues"
  },
  "pi": {},
  "pithagoras": {
    "client": "./web/client.js",
    "style": "./web/client.css",
    "server": "./server.js"
  },
  "files": [
    "web",
    "server.js",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node build.mjs && tsc --noEmit -p .",
